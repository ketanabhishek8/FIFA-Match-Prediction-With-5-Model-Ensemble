{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,outputs/**,docs/**,tests/**,notebooks/**,CONTEXT/**,Report/**,frontend/node_modules/**,frontend/src/**,frontend/public/**}"
    }
  }
}
